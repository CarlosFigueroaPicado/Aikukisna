    <string name="terminos_1_que_es_aikukisna">1. What Aikukisna is</string>
    <string name="terminos_aikukisna_es_una_app_educativa">Aikukisna is an educational app for learning Miskito, Creole English, Standard English and Spanish </string>
    <string name="terminos_de_la_costa_caribe_de">of Nicaragua\'s Caribbean Coast. It is for personal use and for learning purposes.</string>
    <string name="terminos_2_tu_cuenta">2. Your account</string>
    <string name="terminos_eres_responsable_de_los_datos">You are responsible for the information you sign up with and for keeping your password private. </string>
    <string name="terminos_si_eres_menor_de_edad">If you are a minor, use the app with permission from your mother, father or guardian.</string>
    <string name="terminos_3_datos_que_guardamos">3. Data we keep</string>
    <string name="terminos_guardamos_tu_nombre_correo_idioma">We keep your name, email, chosen language and your progress (lessons, XP, achievements and favorites) so </string>
    <string name="terminos_que_no_lo_pierdas_al">that you don\'t lose it when you change phones. That information syncs with our server when </string>
    <string name="terminos_tienes_internet_no_vendemos_tus">you have internet. We do not sell your data.</string>
    <string name="terminos_4_microfono_y_camara">4. Microphone and camera</string>
    <string name="terminos_el_microfono_se_usa_solo">The microphone is used only when you tap the button to speak or practice pronunciation, and the camera </string>
    <string name="terminos_solo_cuando_abres_la_funcion">only when you open the object recognition feature. The app will ask for permission before using them.</string>
    <string name="terminos_5_tuki_y_el_contenido">5. Tuki and automatic content</string>
    <string name="terminos_tuki_y_el_traductor_funcionan">Tuki and the translator work with an artificial intelligence model that is downloaded to your phone </string>
    <string name="terminos_unos_550_mb_las_traducciones">(about 550 MB). Automatically generated translations and answers may contain errors, </string>
    <string name="terminos_todo_en_miskito_y_kriol">especially in Miskito and Creole: use them as support, not as an official source. When you have internet, some </string>
    <string name="terminos_consultas_pueden_enviarse_a_un">questions may be sent to an external AI service to answer you.</string>
    <string name="terminos_6_fuentes_y_respeto_cultural">6. Sources and cultural respect</string>
    <string name="terminos_el_vocabulario_proviene_de_diccionarios">The vocabulary comes from dictionaries, educational materials and open sources (such as Wiktionary and </string>
    <string name="terminos_tatoeba_citadas_en_la_app">Tatoeba), cited in the app. The languages and culture of the Caribbean Coast peoples belong to </string>
    <string name="terminos_sus_comunidades_te_pedimos_usarlas">their communities; we ask you to use them with respect.</string>
    <string name="terminos_7_uso_adecuado">7. Appropriate use</string>
    <string name="terminos_no_uses_la_app_para">Do not use the app to bother other people, and do not try to copy its content in bulk or damage its </string>
    <string name="terminos_8_cambios">8. Changes</string>
    <string name="terminos_si_estos_terminos_cambian_te">If these terms change, we will show them to you again so you can accept them before continuing.</string>
