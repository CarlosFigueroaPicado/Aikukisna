        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Idioma {\n        +Int id\n        +String codigo\n        +String nombre\n    }\n    class Categoria {\n        +Int id\n        +String nombre\n    }\n    class FuenteDocumento {\n        +Int id\n        +String titulo\n        +String? autor\n        +Int? anio\n        +String? institucion\n    }\n    class Leccion {\n        +Int id\n        +String titulo\n        +Int? capituloNumero\n        +Int nivel\n        +Categoria? categoria\n        +Idioma idiomaMeta\n    }\n    class Palabra {\n        +Int id\n        +Idioma idioma\n        +String texto\n        +Categoria? categoria\n        +FuenteDocumento fuente\n    }\n    class Traduccion {\n        +Int id\n        +Palabra palabraOrigen\n        +Palabra palabraDestino\n        +String? nota\n    }\n    class LeccionPalabra {\n        +Leccion leccion\n        +Palabra palabra\n    }\n    class OracionEjemplo {\n        +Int id\n        +String textoOrigen\n        +String textoDestino\n        +Leccion? leccion\n        +FuenteDocumento fuente\n    }\n    class CulturaContenido {\n        +Int id\n        +String titulo\n        +String contenido\n        +Int? rangoPaginaInicio\n        +Int? rangoPaginaFin\n        +FuenteDocumento fuente\n    }\n    class Logro {\n        +Int id\n        +String nombre\n        +String descripcion\n        +String condicionTipo\n        +Int condicionValor\n        +Categoria? categoria\n    }\n    class Usuario {\n        +UUID id\n        +String? nombre\n        +String? apellido\n        +String? nombreUsuario\n        +String? correo\n        +Int? edad\n        +String? pais\n        +String? ciudad\n        +Idioma? idiomaMeta\n        +Int xp\n        +Int rachaActual\n        +Int rachaMaxima\n        +LocalDate? ultimaActividad\n    }\n    class ProgresoLeccion {\n        +UUID usuarioId\n        +Leccion leccion\n        +String estado\n        +Int? puntaje\n        +Instant? fechaCompletado\n    }\n    class PalabraFavorita {\n        +UUID usuarioId\n        +Palabra palabra\n    }\n    class LogroDesbloqueado {\n        +UUID usuarioId\n        +Logro logro\n        +Instant fecha\n    }\n    class MemoriaTuki {\n        +Int id\n        +UUID usuarioId\n        +String tipo\n        +String resumen\n        +Instant fecha\n    }\n\n    Leccion --&gt; Categoria\n    Leccion --&gt; Idioma\n    Palabra --&gt; Idioma\n    Palabra --&gt; Categoria\n    Palabra --&gt; FuenteDocumento\n    Traduccion --&gt; Palabra\n    LeccionPalabra --&gt; Leccion\n    LeccionPalabra --&gt; Palabra\n    OracionEjemplo --&gt; Leccion\n    OracionEjemplo --&gt; FuenteDocumento\n    CulturaContenido --&gt; FuenteDocumento\n    Logro --&gt; Categoria\n    Usuario --&gt; Idioma\n    ProgresoLeccion --&gt; Leccion\n    PalabraFavorita --&gt; Palabra\n    LogroDesbloqueado --&gt; Logro\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="120">
